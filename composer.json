{
    "name": "enesekinci/laravel-livewire-search-select",
    "description": "Searchable select component for Laravel Livewire (Alpine + wire:model).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "alpine",
        "select",
        "search",
        "combobox"
    ],
    "authors": [
        {
            "name": "Enes Ekinci",
            "homepage": "https://github.com/enesekinci"
        }
    ],
    "homepage": "https://github.com/enesekinci/laravel-livewire-search-select",
    "support": {
        "issues": "https://github.com/enesekinci/laravel-livewire-search-select/issues",
        "source": "https://github.com/enesekinci/laravel-livewire-search-select"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "EnesEkinci\\SearchSelect\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EnesEkinci\\SearchSelect\\SearchSelectServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.1.0"
}
