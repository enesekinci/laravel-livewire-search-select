{
    "name": "enesekinci/laravel-livewire-search-select",
    "description": "Searchable select component for Laravel Livewire (Alpine + wire:model).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "alpine", "select", "search", "combobox"],
    "authors": [
        {
            "name": "Enes Ekinci",
            "email": "enesekinci@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "EnesEkinci\\SearchSelect\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EnesEkinci\\SearchSelect\\SearchSelectServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
